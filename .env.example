# Copy to .env.local (never commit .env.local)
# Firebase Web SDK (safe as NEXT_PUBLIC_*).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=

# Single-user allowlist (set at least one; UID preferred).
NEXT_PUBLIC_ALLOWED_USER_UID=
NEXT_PUBLIC_ALLOWED_EMAIL=

# Server-side allowlist (session API + Edge proxy when set).
ALLOWED_USER_UID=
ALLOWED_USER_EMAIL=

# Cookie name (underscore; match code default mesi_session).
AUTH_SESSION_COOKIE_NAME=mesi_session

# Optional session TTL override (seconds).
# AUTH_COOKIE_MAX_AGE_SECONDS=3300

# Firebase Admin (server-only).
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Use literal \n for multiline private key in .env.local.
FIREBASE_ADMIN_PRIVATE_KEY=

# Google AI / Gemini (server routes - not exposed to client).
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
